opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/public-release-reloaded/splittable_random"
bug-reports: "https://github.com/public-release-reloaded/splittable_random/issues"
dev-repo: "git+https://github.com/public-release-reloaded/splittable_random.git#v0.18_preview.130.100+614+reloaded"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/splittable_random/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.5.0"}
  "base" {>= "v0.18~" & < "v0.19~"}
  "capsule0" {>= "v0.18~" & < "v0.19~"}
  "ppx_assert" {>= "v0.18~" & < "v0.19~"}
  "ppx_bench" {>= "v0.18~" & < "v0.19~"}
  "ppx_inline_test" {>= "v0.18~" & < "v0.19~"}
  "ppx_sexp_message" {>= "v0.18~" & < "v0.19~"}
  "dune" {>= "3.17.0"}
]
available: arch != "x86_32"
synopsis: "PRNG that can be split into independent streams"
description: "
PRNG that can be split into independent streams

A splittable pseudo-random number generator (SPRNG) functions like a PRNG in that it can
be used as a stream of random values; it can also be \"split\" to produce a second,
independent stream of random values.

This library implements a splittable pseudo-random number generator that sacrifices
cryptographic-quality randomness in favor of performance.
"
